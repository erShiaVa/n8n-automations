        "jsCode": "// Bei grundsätzlichen Fehlern höchstens 1 Mail pro Stunde schicken\nconst speicher = $getWorkflowStaticData('global');\nconst jetzt = Date.now();\nif (speicher.letzteFehlermail && jetzt - speicher.letzteFehlermail < 60 * 60 * 1000) return [];\nspeicher.letzteFehlermail = jetzt;\nconst e = $input.first().json.error ?? $input.first().json;\nconst text = typeof e === 'string' ? e : (e.message || JSON.stringify(e));\nreturn [{ json: { fehler: text, schritt: $prevNode.name } }];\n"
