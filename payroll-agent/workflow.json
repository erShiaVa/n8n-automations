    {
      "parameters": {
        "jsCode": "// Jede gefundene Abrechnung prüfen: senden oder ignorieren (mit Grund)\nconst cfg = $('⚙️ Einstellungen').first().json;\nconst scan = $('📂 Eingang prüfen').first().json;\nconst liste = $('👤 Mitarbeiterliste lesen').all().map(i => i.json)\n  .filter(r => r.personalnummer !== undefined && String(r.personalnummer).trim() !== '');\nconst protokoll = $('📋 Versandprotokoll lesen').all().map(i => i.json);\n\nconst norm = s => String(s ?? '').trim().toLowerCase();\nconst schluessel = (nr, monat, jahr) => `${parseInt(nr, 10)}|${monat}|${jahr}`;\n\n// Nur echte Versendungen (nicht Testläufe) blockieren einen erneuten Versand\nconst schonVersendet = new Set(\n  protokoll.filter(p => norm(p.status) === 'versendet')\n    .map(p => schluessel(p.personalnummer, p.monat, p.jahr))\n);\n\nconst out = [];\nfor (const a of scan.abrechnungen) {\n  const basis = { quelle: a.quelle, pdf: a.pdf, seiten: a.seiten,\n    personalnummer: a.personalnummer, monat: a.monat, jahr: a.jahr };\n  const person = liste.find(m => parseInt(m.personalnummer, 10) === a.personalnummer);\n\n  let grund = '';\n  if (!a.monat || !a.jahr) grund = 'Monat/Jahr nicht gefunden';\n  else if (!a.seitenzahl_ok) grund = 'Seiten unvollständig (Seite x von y passt nicht)';\n  else if (!person) grund = 'Personalnummer nicht in der Mitarbeiterliste';\n  else if (norm(person.status) !== 'aktiv') grund = `Status ist „${person.status || 'leer'}“`;\n  else if (!norm(a.name_pdf).includes(norm(person.name).split(/\\s+/).pop()))\n    grund = `Name passt nicht zur Personalnummer (PDF: ${a.name_pdf})`;\n  else if (!person.email) grund = 'Keine E-Mail-Adresse in der Liste';\n  else if (!String(person.passwort ?? '').trim()) grund = 'Kein Passwort in der Liste';\n  else if (schonVersendet.has(schluessel(a.personalnummer, a.monat, a.jahr)))\n    grund = 'Wurde bereits versendet (laut Versandprotokoll)';\n\n  if (grund) {\n    out.push({ json: { ...basis, name: person ? person.name : a.name_pdf, status: 'ignoriert', grund } });\n    continue;\n  }\n\n  const name = String(person.name).trim();\n  const dateiname = `${name.replace(/[^\\p{L}\\p{N}-]+/gu, '_')}_${a.monat}_${a.jahr}_Lohnabrechnung.pdf`;\n  const betreff = `FIRMA | Lohnabrechnung ${a.monat} ${a.jahr}`;\n  out.push({ json: {\n    ...basis, name, email: person.email, passwort: String(person.passwort).trim(), dateiname,\n    empfaenger: cfg.testmodus ? cfg.testadresse : person.email,\n    betreff: cfg.testmodus ? `[TEST → ${person.email}] ${betreff}` : betreff,\n    status: 'senden',\n  } });\n}\n\nfor (const i of scan.ignoriert) {\n  out.push({ json: { quelle: i.quelle, pdf: i.pdf || '', seiten: i.seiten || [], name: '',\n    status: 'ignoriert', grund: i.grund } });\n}\n\nif (out.length === 0) out.push({ json: { status: 'leer' } });\nreturn out;\n"
      },
