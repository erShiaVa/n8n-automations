    {
      "parameters": {
        "jsCode": "// Übersicht für die verantwortliche Person bauen\nconst cfg = $('⚙️ Einstellungen').first().json;\nconst scan = $('📂 Eingang prüfen').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.status !== 'leer');\nconst esc = s => String(s ?? '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\n\nconst ok = rows.filter(r => r.status === 'versendet' || r.status === 'test');\nconst ign = rows.filter(r => r.status === 'ignoriert');\nconst err = rows.filter(r => r.status === 'fehler');\n\nconst liste = (arr, f) => arr.length ? '<ul>' + arr.map(r => `<li>${f(r)}</li>`).join('') + '</ul>' : '<p>–</p>';\nconst seiten = r => (r.seiten && r.seiten.length) ? ` (Seite ${r.seiten.map(s => s + 1).join(', ')})` : '';\n\nlet html = '';\nif (cfg.testmodus) html += '<p><b>🧪 TESTMODUS:</b> Alle Mails gingen an ' + esc(cfg.testadresse) + ', nicht an die Mitarbeiter.</p>';\nhtml += `<p>Datei(en): ${scan.quellen.map(esc).join(', ')}</p>`;\nhtml += `<h3>✅ ${ok.length} versendet</h3>` + liste(ok, r =>\n  `${esc(r.name)} (Nr. ${r.personalnummer}) – ${esc(r.monat)} ${esc(r.jahr)} → ${esc(r.empfaenger)}` + (r.hinweis ? ` ⚠️ ${esc(r.hinweis)}` : ''));\nhtml += `<h3>⏭️ ${ign.length} ignoriert</h3>` + liste(ign, r =>\n  `${esc(r.name) || 'unbekannt'}${r.personalnummer ? ` (Nr. ${r.personalnummer})` : ''}${seiten(r)}: ${esc(r.grund)}`);\nhtml += `<h3>❌ ${err.length} Fehler</h3>` + liste(err, r =>\n  `${esc(r.name)} (Nr. ${r.personalnummer}): ${esc(r.grund)}`);\nif (err.length) html += '<p>Bei Fehlern: Datei erneut in den Ordner „eingang“ legen. Bereits versendete Abrechnungen werden nicht doppelt verschickt.</p>';\n\nconst betreff = `${cfg.testmodus ? '🧪 TEST – ' : ''}Payroll: ${ok.length} versendet, ${ign.length} ignoriert, ${err.length} Fehler`;\nreturn [{ json: { betreff, html, quellen: scan.quellen } }];\n"
      },
